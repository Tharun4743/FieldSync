\DeclareFontShape{TU}{phv}{b}{it}{<-> ssub * lmss/bx/sl}{}
\DeclareFontShape{TU}{phv}{bx}{it}{<-> ssub * lmss/bx/sl}{}
\DeclareFontShape{TU}{phv}{m}{sl}{<-> ssub * lmss/m/sl}{}
\DeclareFontShape{TU}{phv}{b}{sl}{<-> ssub * lmss/bx/sl}{}
\DeclareFontShape{TU}{phv}{bx}{sl}{<-> ssub * lmss/bx/sl}{}
